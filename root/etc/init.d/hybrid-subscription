#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
 /usr/bin/ruby /usr/share/hybrid-subscription/cli.rb init
 procd_open_instance
 procd_set_param command /bin/sh -c 'while :; do /usr/bin/ruby /usr/share/hybrid-subscription/cli.rb tick >/dev/null 2>&1; sleep 60; done'
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
